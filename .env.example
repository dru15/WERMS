APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://werms:werms@localhost:5432/werms
REDIS_URL=redis://localhost:6379/0
SHELTER_REDIRECT_THRESHOLD=0.90
ROUTE_VALIDITY_SECONDS=300
MODEL_MODE=disabled
MODEL_ARTIFACT_PATH=artifacts/models/approved
