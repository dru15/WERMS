SPATIAL_DATABASE_URL=
OPERATIONAL_DB_PATH=data/operational/dehradun.sqlite3
WEATHER_ENABLED=true
# Optional paid Open-Meteo key. Free hosted access is for non-commercial use only.
WEATHER_API_KEY=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional in development (a key is generated beside the database).
# Required in production: a random secret of at least 24 characters.
OPERATOR_API_KEY=
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

